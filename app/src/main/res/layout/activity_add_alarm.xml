<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".presentation.ui.create.CreateAlarmActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_100">
        <LinearLayout
            android:id="@+id/ll_create_alarm_top"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_create_alarm_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:minWidth="100dp"
                    android:textColorHint="@color/gray_300"
                    android:textColor="@color/black"
                    android:editable="false"
                    android:focusable="false"
                    android:gravity="center"
                    android:hint="장소, 주소, 위치">
                </androidx.appcompat.widget.AppCompatEditText>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:text="위치를"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:text="기준으로 반경"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_create_alarm_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:minWidth="100dp"
                    android:editable="false"
                    android:focusable="false"
                    android:textColorHint="@color/gray_300"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:hint="50/100/200/400/800">
                </androidx.appcompat.widget.AppCompatEditText>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:text=" m를 "/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_create_alarm_way"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:minWidth="100dp"
                    android:focusable="false"
                    android:editable="false"
                    android:gravity="center"
                    android:textColorHint="@color/gray_300"
                    android:textColor="@color/black"
                    android:hint="진입하면/벗어나면">
                </androidx.appcompat.widget.AppCompatEditText>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:text="알려주는 위치 알람"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/ll_create_alarm_top"
            app:layout_constraintBottom_toTopOf="@+id/ll_create_alarm_bottom"
            android:padding="8dp"
            android:orientation="vertical">
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_r24_f_white"
                    android:orientation="vertical">
                        <EditText
                            android:id="@+id/et_create_alarm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray_300"
                            android:hint="장소, 주소, 위치"
                            android:focusable="false"
                            android:editable="false"
                            android:layout_marginTop="20dp"
                            android:textSize="16sp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="16sp"
                                    android:text="진입하면/벗어나면"/>
                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tv_create_alarm_way"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:textColor="@color/purple_400"
                                    tools:text="5초"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_weight="1"/>
                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="16dp"
                                android:layout_marginHorizontal="8dp"
                                android:background="@color/gray_300"/>
                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/sw_create_alarm_way"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:thumb="@drawable/shape_switch_track_off"
                                app:track="@drawable/shape_switch_track_on"
                                app:thumbTextPadding="24dp"
                                app:switchMinWidth="0dp"
                                android:textOff=""
                                android:textOn=""
                                android:background="@color/white"/>
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/gray_300"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_create_alarm_bottom"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="horizontal"
            android:gravity="center">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_create_cancel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="@string/str_cancel"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_create_save"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="@string/str_save"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>