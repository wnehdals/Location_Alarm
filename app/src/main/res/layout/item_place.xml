<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_list_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white">
        <LinearLayout
            android:id="@+id/ll_item_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:gravity="start|bottom"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_loc_blue400"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_item_place_dialog"
                style="@style/Paragraph.S"
                android:layout_marginStart="8dp"
                android:textColor="@color/c_item_select"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                tools:text="테스트"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_item_place_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Paragraph.XS"
                tools:text="다이어트"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_item_place_address"
            style="@style/Paragraph.XS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/ll_item_place"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="48dp"
            android:textColor="@color/gray_600"
            tools:text="서울특별시"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_item_place_address"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_200"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>